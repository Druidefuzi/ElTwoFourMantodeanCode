<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The machine-wide NuGet config points at a Visual Studio shared package
       folder that does not exist on every machine, which fails the restore with
       NU1301 before any package is even downloaded. Clearing the inherited
       fallback folders here keeps the build working regardless of what Visual
       Studio did or did not install. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
